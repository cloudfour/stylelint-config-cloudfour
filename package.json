{
  "name": "stylelint-config-cloudfour",
  "version": "12.0.0",
  "description": "Cloud Four's stylelint config",
  "keywords": [
    "stylelint",
    "stylelint-config",
    "cloudfour"
  ],
  "repository": "cloudfour/stylelint-config-cloudfour",
  "license": "MIT",
  "author": "Cloud Four",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./scss": "./scss.js"
  },
  "main": "index.js",
  "files": [
    "index.js",
    "scss.js"
  ],
  "scripts": {
    "lint": "run-s lint:js lint:md:check lint:prettier",
    "lint:check": "run-s lint:*:check",
    "lint:js": "eslint --fix .",
    "lint:js:check": "eslint .",
    "lint:md:check": "remark . --quiet --frail",
    "lint:prettier": "prettier --write .",
    "lint:prettier:check": "prettier --list-different .",
    "test": "node --test",
    "test:watch": "npm test --ignore-scripts -- --watch"
  },
  "prettier": "@stylelint/prettier-config",
  "remarkConfig": {
    "plugins": [
      "@stylelint/remark-preset"
    ]
  },
  "dependencies": {
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-declaration-block-no-ignored-properties": "3.0.0",
    "stylelint-high-performance-animation": "2.0.0",
    "stylelint-order": "8.1.1"
  },
  "devDependencies": {
    "@stylelint/prettier-config": "4.0.0",
    "@stylelint/remark-preset": "5.1.1",
    "eslint": "10.12.0",
    "eslint-config-stylelint": "27.0.0",
    "npm-run-all2": "9.0.3",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "remark-cli": "12.0.1",
    "stylelint": "17.16.0"
  },
  "peerDependencies": {
    "stylelint": "^17.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
